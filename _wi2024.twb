      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0nwrb8b1xoqnsf1dnja360y7cceu].[avg:Birth Rate:qk]&quot;' value='Birth Rate ' />
          <alias key='&quot;[federated.0nwrb8b1xoqnsf1dnja360y7cceu].[avg:Calculation_638103803600809984:qk]&quot;' value='Life Expectancy' />
          <alias key='&quot;[federated.0nwrb8b1xoqnsf1dnja360y7cceu].[avg:Health Exp \% GDP:qk]&quot;' value='Health Exp % GDP ' />
          <alias key='&quot;[federated.0nwrb8b1xoqnsf1dnja360y7cceu].[avg:Infant Mortality Rate:qk]&quot;' value='Infant Mortality' />
          <alias key='&quot;[federated.0nwrb8b1xoqnsf1dnja360y7cceu].[usr:Calculation_1554586357507932164:qk]&quot;' value='GDP per Capita' />
        </aliases>
      </column>
      <column datatype='real' default-format='p0.0%' name='[Birth Rate]' role='measure' type='quantitative' />
      <column aggregation='Count' datatype='real' datatype-customized='true' default-format='p0%' name='[Business Tax Rate]' role='measure' type='ordinal' />
      <column caption='Above Threshold?' datatype='string' name='[Calculation_1554586357494272000]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Health Exp % GDP]&gt;[Parameters].[Parameter 1] then &quot;Above Threshold&quot; else &quot;Below Threshold&quot; end' />
      </column>
      <column caption='GDP per Capita' datatype='real' default-format='c&quot;$&quot;#,##0' name='[Calculation_1554586357495853057]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[GDP]/[Population Total]' />
      </column>
      <column caption='Birth Rate Bin' datatype='string' name='[Calculation_1554586357496451074]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if ([Birth Rate])&lt;0.015 then &quot;Below 1.5%&quot; elseif&#13;&#10;([Birth Rate])&lt;0.03 then &quot;1.5-3%&quot; else&#13;&#10;&quot;Above 3%&quot; end' />
      </column>
      <column caption='Life Expectancy' datatype='real' default-format='n#,##0' name='[Calculation_638103803600809984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Life Expectancy Female]+[Life Expectancy Male])/2' />
      </column>
      <column caption='Ease of Business (clusters)' datatype='string' name='[Country/Region (clusters)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal'>
        <calculation class='categorical-bin' column='[Country/Region]' default='&quot;Not Clustered&quot;' new-bin='true'>
          <bin default-name='false' value='&quot;Friendly&quot;'>
            <value>&quot;Albania&quot;</value>
            <value>&quot;Antigua and Barbuda&quot;</value>
            <value>&quot;Azerbaijan&quot;</value>
            <value>&quot;Bahamas, The&quot;</value>
            <value>&quot;Barbados&quot;</value>
            <value>&quot;Belarus&quot;</value>
            <value>&quot;Botswana&quot;</value>
            <value>&quot;Brunei&quot;</value>
            <value>&quot;Bulgaria&quot;</value>
            <value>&quot;China&quot;</value>
            <value>&quot;Croatia&quot;</value>
            <value>&quot;Czechia&quot;</value>
            <value>&quot;Dominica&quot;</value>
            <value>&quot;Fiji Islands&quot;</value>
            <value>&quot;Ghana&quot;</value>
            <value>&quot;Greece&quot;</value>
            <value>&quot;Guatemala&quot;</value>
            <value>&quot;Hungary&quot;</value>
