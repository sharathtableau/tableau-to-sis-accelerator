table Orders
	lineageTag: d3799f83-2f22-5105-b854-f918593110c7

	measure 'Total Sales' = SUM(Orders[Sales])
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 7a63d08c-75b2-5046-93df-80ececcfd5b6

	measure 'Total Profit' = SUM(Orders[Profit])
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 691d77f4-69c9-5687-b1dc-1dc23bfbd472

	measure 'Profit Ratio' = DIVIDE([Total Profit], [Total Sales])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 1e6633db-d925-57bc-9409-2b2790e7d696

	measure 'Total Quantity' = SUM(Orders[Quantity])
		formatString: #,0
		lineageTag: abac6454-3f22-5b7d-95ee-ff0896ac9470

	measure 'Order Count' = DISTINCTCOUNT(Orders[Order ID])
		formatString: #,0
		lineageTag: e474584a-06e9-5fb5-9026-50e89f384af1

	measure 'Customer Count' = DISTINCTCOUNT(Orders[Customer ID])
		formatString: #,0
		lineageTag: e6b5c0b7-c725-5608-aa2f-7f120ed819ba

	measure 'Avg Discount' = AVERAGE(Orders[Discount])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 59c9fd8c-098d-50d3-be5d-c2baacdfa8c2

	measure 'Sales per Customer' = DIVIDE([Total Sales], [Customer Count])
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: b53ba75d-dedf-5954-b834-dba8dfeb50a0

	measure 'Furniture Sales' = CALCULATE([Total Sales], Orders[Category] = "Furniture")
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: e46dac86-6dae-582e-a164-32b2a3fc2417

	measure 'Avg Days to Ship' = AVERAGEX(Orders, DATEDIFF(Orders[Order Date], Orders[Ship Date], DAY))
		formatString: 0.0
		lineageTag: b93f4aaf-4d3e-512d-8321-26e1684cf848

	measure 'Sales LY' = CALCULATE([Total Sales], SAMEPERIODLASTYEAR('Date'[Date]))
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: aa70ff07-20c9-59b5-9ec6-5381eb168259

	measure 'Sales YoY %' = VAR ly = [Sales LY] RETURN DIVIDE([Total Sales] - ly, ly)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: ffeeddd2-28da-5749-8274-01c26813c64c

