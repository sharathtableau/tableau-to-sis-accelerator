	partition Orders = m
		mode: import
		source =
				let
				    Source = Snowflake.Databases(SnowflakeServer, SnowflakeWarehouse),
				    Db = Source{[Name = SnowflakeDatabase, Kind = "Database"]}[Data],
				    Sch = Db{[Name = SnowflakeSchema, Kind = "Schema"]}[Data],
				    Orders = Sch{[Name = "SAMPLE_SUPERSTORE", Kind = "Table"]}[Data],
				    Typed = Table.TransformColumnTypes(Orders, {{"ORDER_DATE", type datetime}, {"SHIP_DATE", type datetime}, {"POSTAL_CODE", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table
