# ===========================================================================
# Tableau -> Streamlit-in-Snowflake Accelerator
# ---------------------------------------------------------------------------
# Principle: track SOURCE (code, docs, the test corpus, config) and never
# track anything the pipeline can REGENERATE from it. Without these rules the
# working tree is ~263 MB; with them it is ~30 MB.
# ===========================================================================

# --- Secrets: nothing credential-bearing is committed today (credentials come
# --- from getpass / env vars / Snowflake secret bindings). These rules keep it
# --- that way if someone later adds a local config.
.env
.env.*
!.env.example
secrets.toml
.streamlit/secrets.toml
connections.toml
*.pem
*.p8
*.key
credentials.json

# --- Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# --- Node (blend_analysis tooling -- 28 MB, restore with `npm install`)
node_modules/

# --- Tableau extract decode artifacts (regenerated by init_workbook /
# --- pipeline.onboard from the .twbx files, which ARE tracked). ~54 MB.
*.hyper
federated_*.csv
federated_*.hyper
TEMP_*.csv
TEMP_*.hyper
*.twbr
~*.twbr

# --- Hyper API server log (49 MB, pure noise)
hyperd.log
hyperd*.log

# --- Generated output: validation packs, migration reports, deploy bundles.
# --- All rebuilt by report.py / deep_validation.py / the Stage-5 pack build.
reports/
output/
_preview/
_tmp_hyper/
screenshots/
metadata/compatibility_report.json

# --- Generated app + SQL (codegen.py / report.py rebuild these).
# --- NOTE the exception: app_screenshot.py is REAL SOURCE (the Playwright
# --- capture module, ARCHITECTURE.md section 18) and is listed in
# --- snowflake.yml's artifacts -- it only happens to share the app_ prefix.
# --- Excluding it broke a fresh clone with
# --- "ModuleNotFoundError: No module named 'app_screenshot'".
app_*.py
!app_screenshot.py
sql/generated_views.sql
sql/semantic_views.sql

# --- Presentation decks (11.4 MB, 25 files). Deliverables/history, not code
# --- the accelerator needs -- removed from git 2026-08-13. Local copies kept.
*.pptx
*.potx

# --- Editor / OS cruft
.~lock.*#
~$*
*.bak
*.orig
*.pre-*-merge.bak
.DS_Store
Thumbs.db
desktop.ini

# --- CLIENT DATA -- deliberately never committed (explicit decision
# --- 2026-08-13). These parsed IR fixtures carry real client dashboard
# --- structure and embedded data rows. No tracked code or gate references
# --- them (verified before removal), so excluding them costs nothing.
# --- Local copies are kept on disk; they are simply not in git.
emea_dtc_performance_kpis_ir.json
rfid_osa_store_level_dashboard_1_ir.json
executive_reporting_flash_daily_dtc_wtd_daily_ecomm_2_ir.json
*emea_dtc*
*rfid_osa*
*executive_reporting_flash*
EMEA*.twbx
EMEA*.csv

# --- Scratch / experiment files (leading underscore is this project's own
# --- convention for throwaway workbooks and IR dumps)
_baseline_ir.json
_new_ir.json
_demo_*.json
_filtest*
_tmp*
streamlit_local.log
