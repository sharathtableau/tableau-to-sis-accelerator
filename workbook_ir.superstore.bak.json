{
  "source_file": "Superstore.twb",
  "calcs": {
    "Achievement (estimated)": {
      "sql": "SALES",
      "agg_ready": false
    },
    "Achieved Quota": {
      "sql": "CASE WHEN SUM((SALES)) >= __PARAM_NEW_QUOTA__ THEN '100% +'\nWHEN SUM((SALES)) >= 0.75 * __PARAM_NEW_QUOTA__ THEN '75-100%'\nWHEN SUM((SALES)) >= 0.5 * __PARAM_NEW_QUOTA__ THEN '50-75%'\nELSE 'Below 50%' END",
      "agg_ready": true
    },
    "Base (Variable)": {
      "sql": "__PARAM_BASE_SALARY__",
      "agg_ready": false
    },
    "% of quota achieved": {
      "sql": "AVG((SALES))/__PARAM_NEW_QUOTA__",
      "agg_ready": true
    },
    "Rank over 3": {
      "sql": "ROUND(ROW_NUMBER() OVER (__WIN_ORDER__) / 3 - 0.6,0) + 1",
      "agg_ready": true,
      "window": true
    },
    "Sort by field": {
      "sql": "CASE WHEN __PARAM_SORT_BY__='Names' THEN 0\nWHEN __PARAM_SORT_BY__='% quota descending' THEN -(AVG((SALES))/__PARAM_NEW_QUOTA__)\nELSE (AVG((SALES))/__PARAM_NEW_QUOTA__) END",
      "agg_ready": true
    },
    "Commission (Variable)": {
      "sql": "(__PARAM_COMMISSION_RATE__*SALES)/100",
      "agg_ready": false
    },
    "Estimate Compensation label": {
      "sql": "'Estimated Compensation:'",
      "agg_ready": false
    },
    "OTE (Variable)": {
      "sql": "__PARAM_BASE_SALARY__ + (__PARAM_COMMISSION_RATE__*__PARAM_NEW_QUOTA__)/100",
      "agg_ready": false
    },
    "Total Compensation": {
      "sql": "MIN((__PARAM_BASE_SALARY__)) + SUM(((__PARAM_COMMISSION_RATE__*SALES)/100))",
      "agg_ready": true
    },
    "Total Sales label": {
      "sql": "'Total Sales:'",
      "agg_ready": false
    },
    "Days to Ship Actual": {
      "sql": "DATEDIFF('day',ORDER_DATE,SHIP_DATE)",
      "agg_ready": false
    },
    "Sales Forecast": {
      "sql": "SALES*(1-__PARAM_CHURN_RATE__)*(1+__PARAM_NEW_BUSINESS_GROWTH__)",
      "agg_ready": false
    },
    "Ship Status": {
      "sql": "CASE WHEN (DATEDIFF('day',ORDER_DATE,SHIP_DATE))> (CASE  SHIP_MODE\nWHEN 'Same Day' THEN 0\nWHEN 'First Class' THEN 1\nWHEN 'Second Class' THEN 3\nWHEN 'Standard Class' THEN 6\nEND) THEN 'Shipped Late' \nWHEN (DATEDIFF('day',ORDER_DATE,SHIP_DATE))= (CASE  SHIP_MODE\nWHEN 'Same Day' THEN 0\nWHEN 'First Class' THEN 1\nWHEN 'Second Class' THEN 3\nWHEN 'Standard Class' THEN 6\nEND) THEN 'Shipped On Time'\nELSE 'Shipped Early' END",
      "agg_ready": false
    },
    "Days to Ship Scheduled": {
      "sql": "CASE  SHIP_MODE\nWHEN 'Same Day' THEN 0\nWHEN 'First Class' THEN 1\nWHEN 'Second Class' THEN 3\nWHEN 'Standard Class' THEN 6\nEND",
      "agg_ready": false
    },
    "Order Profitable?": {
      "sql": "SUM(PROFIT) OVER (PARTITION BY ORDER_ID)>0",
      "agg_ready": false
    },
    "Sales per Customer": {
      "sql": "Sum(SALES)/ NULLIF(COUNT(DISTINCT CUSTOMER_NAME), 0)",
      "agg_ready": true
    },
    "Profit Ratio": {
      "sql": "sum(PROFIT)/ NULLIF(sum(SALES), 0)",
      "agg_ready": true
    },
    "Sales above Target?": {
      "sql": "CASE WHEN Sum(SALES)>SUM(FEDERATED_0HGPF0J1FDPVV316SHIKK0MMDLEC.SALES_TARGET) THEN 'Above Target' ELSE 'Below Target' END",
      "agg_ready": true
    },
    "Units estimate": {
      "sql": "ROUND(QUANTITY*(1-__PARAM_CHURN_RATE__)*(1+__PARAM_NEW_BUSINESS_GROWTH__),0)",
      "agg_ready": false
    },
    "Profit per Order": {
      "sql": "Sum(PROFIT)/ NULLIF(COUNT(DISTINCT ORDER_ID), 0)",
      "agg_ready": true
    },
    "SUM([Sales])-SUM([Sales Target].[Sales Target])": {
      "sql": "SUM(SALES)-SUM(FEDERATED_0HGPF0J1FDPVV316SHIKK0MMDLEC.SALES_TARGET)",
      "agg_ready": true
    },
    "SUM([Sales])-SUM([Sales Forecast])": {
      "sql": "SUM(SALES)-SUM((SALES*(1-__PARAM_CHURN_RATE__)*(1+__PARAM_NEW_BUSINESS_GROWTH__)))",
      "agg_ready": true
    }
  },
