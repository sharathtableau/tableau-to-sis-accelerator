  "calcs": {
    "MTD_Sales": {
      "sql": "'MTD_Sales'",
      "agg_ready": false
    },
    "MTD Sales": {
      "sql": "SUM(\nCASE WHEN DATE_TRUNC('month', ORDER_DATE) = DATE_TRUNC('month', ((SELECT max(ORDER_DATE) FROM __TBL__)))\nAND ORDER_DATE <= ((SELECT max(ORDER_DATE) FROM __TBL__))\nTHEN SALES\nEND\n)",
      "agg_ready": true
    },
    "SUM_OF_SALES": {
      "sql": "sum(SALES)",
      "agg_ready": true
    },
    "Category is Furniture": {
      "sql": "CASE CATEGORY \nwhen 'Furniture'\nTHEN 'true'\nELSE 'false'\nEND",
      "agg_ready": false
    },
    "YTD SALES": {
      "sql": "SUM(\nCASE WHEN YEAR(ORDER_DATE) = YEAR(((SELECT max(ORDER_DATE) FROM __TBL__)))\nAND ORDER_DATE <= ((SELECT max(ORDER_DATE) FROM __TBL__))\nTHEN SALES\nEND\n)",
      "agg_ready": true
    },
    "Max Order Date": {
      "sql": "(SELECT max(ORDER_DATE) FROM __TBL__)",
      "agg_ready": false
    },
    "% Diff": {
      "sql": "(SUM(SALES)-SUM(NULL))/ NULLIF(SUM(NULL), 0)",
      "agg_ready": true
    },
    "Profit_Ratio": {
      "sql": "SUM(PROFIT)/ NULLIF(SUM(SALES), 0)",
      "agg_ready": true
    },
